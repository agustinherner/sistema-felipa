generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMIN
  VENDEDOR
}

enum TipoMovimiento {
  INGRESO
  VENTA
  AJUSTE_ROTURA
  AJUSTE_ROBO
  AJUSTE_CONTEO
  DEVOLUCION
  ANULACION_VENTA
}

model HealthCheck {
  id        Int      @id @default(autoincrement())
  checkedAt DateTime @default(now())
}

model Sucursal {
  id        String   @id @default(cuid())
  nombre    String   @unique
  direccion String?
  activa    Boolean  @default(true)
  creadaEn  DateTime @default(now())

  usuarios    User[]
  stocks      Stock[]
  ventas      Venta[]
  movimientos MovimientoStock[]
}

model Categoria {
  id          String  @id @default(cuid())
  nombre      String  @unique
  descripcion String?

  productos Producto[]
}

model Producto {
  id            String   @id @default(cuid())
  nombre        String
  descripcion   String?
  categoriaId   String?
  precioBase    Decimal  @db.Decimal(12, 2)
  costoBase     Decimal  @db.Decimal(12, 2)
  activo        Boolean  @default(true)
  incompleto    Boolean  @default(false)
  creadoPorId   String?
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  categoria Categoria? @relation(fields: [categoriaId], references: [id])
  variantes Variante[]
  creadoPor User?      @relation("ProductosCreados", fields: [creadoPorId], references: [id])

  @@index([categoriaId])
  @@index([incompleto])
}

model Variante {
  id            String   @id @default(cuid())
  productoId    String
  nombre        String
  atributos     Json?
  codigoBarras  String?  @unique
  precio        Decimal? @db.Decimal(12, 2)
  costo         Decimal? @db.Decimal(12, 2)
  activa        Boolean  @default(true)
  creadaEn      DateTime @default(now())
  actualizadaEn DateTime @updatedAt

  producto    Producto          @relation(fields: [productoId], references: [id])
  stocks      Stock[]
  itemsVenta  ItemVenta[]
  movimientos MovimientoStock[]

  @@index([productoId])
}

model Stock {
  id            String   @id @default(cuid())
  varianteId    String
  sucursalId    String
  cantidad      Int      @default(0)
  actualizadoEn DateTime @default(now())

  variante Variante @relation(fields: [varianteId], references: [id])
  sucursal Sucursal @relation(fields: [sucursalId], references: [id])

  @@unique([varianteId, sucursalId])
  @@index([sucursalId])
}

// Tabla de usuarios. Renombrada a `User` (lowercase en SQL via @@map)
// para satisfacer la convencion de Better Auth. Las columnas de dominio
// (nombre, rol, activo, creadoEn, actualizadoEn) se mantienen en español
// y se mapean a los nombres logicos de Better Auth (name, createdAt,
// updatedAt) desde lib/auth/server.ts via `user.fields`.
model User {
  id              String   @id @default(cuid())
  email           String   @unique
  emailVerified   Boolean  @default(false)
  nombre          String
  image           String?
  username        String?  @unique
  displayUsername String?
  rol             Rol      @default(VENDEDOR)
  activo          Boolean  @default(true)
  sucursalId      String?
  creadoEn        DateTime @default(now())
  actualizadoEn   DateTime @updatedAt

  sucursal         Sucursal?         @relation(fields: [sucursalId], references: [id])
  ventas           Venta[]
  ventasAnuladas   Venta[]           @relation("VentasAnuladas")
  movimientos      MovimientoStock[]
  sessions         Session[]
  accounts         Account[]
  turnos           Turno[]
  productosCreados Producto[]        @relation("ProductosCreados")

  @@index([sucursalId])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model Venta {
  id              String    @id @default(cuid())
  codigoCorto     String    @unique
  sucursalId      String
  usuarioId       String
  subtotal        Decimal   @db.Decimal(12, 2)
  descuentoTotal  Decimal   @default(0) @db.Decimal(12, 2)
  descuentoTipo   String?
  descuentoValor  Decimal?  @db.Decimal(12, 2)
  total           Decimal   @db.Decimal(12, 2)
  aplicaDescuento Boolean   @default(false)
  metodosPago     Json
  whatsappCliente String?
  creadaEn        DateTime  @default(now())
  turnoId         String?
  anuladaEn       DateTime?
  anuladaPorId    String?
  motivoAnulacion String?

  sucursal    Sucursal          @relation(fields: [sucursalId], references: [id])
  usuario     User              @relation(fields: [usuarioId], references: [id])
  anuladaPor  User?             @relation("VentasAnuladas", fields: [anuladaPorId], references: [id])
  turno       Turno?            @relation(fields: [turnoId], references: [id])
  items       ItemVenta[]
  movimientos MovimientoStock[]

  @@index([sucursalId, creadaEn])
  @@index([usuarioId])
  @@index([anuladaEn])
}

model ItemVenta {
  id             String  @id @default(cuid())
  ventaId        String
  varianteId     String
  cantidad       Int
  precioUnitario Decimal @db.Decimal(12, 2)
  subtotal       Decimal @db.Decimal(12, 2)

  venta    Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  variante Variante @relation(fields: [varianteId], references: [id])

  @@index([ventaId])
  @@index([varianteId])
}

model MovimientoStock {
  id         String         @id @default(cuid())
  varianteId String
  sucursalId String
  tipo       TipoMovimiento
  cantidad   Int
  motivo     String?
  usuarioId  String
  ventaId    String?
  creadoEn   DateTime       @default(now())

  variante Variante @relation(fields: [varianteId], references: [id])
  sucursal Sucursal @relation(fields: [sucursalId], references: [id])
  usuario  User     @relation(fields: [usuarioId], references: [id])
  venta    Venta?   @relation(fields: [ventaId], references: [id])

  @@index([varianteId])
  @@index([sucursalId, creadoEn])
  @@index([ventaId])
}

model Turno {
  id                       String    @id @default(cuid())

  userId                   String
  user                     User      @relation(fields: [userId], references: [id])

  aperturaEn               DateTime  @default(now())
  cierreEn                 DateTime?

  efectivoInicialDeclarado Decimal   @db.Decimal(12, 2)
  efectivoContadoCierre    Decimal?  @db.Decimal(12, 2)
  efectivoEsperadoCierre   Decimal?  @db.Decimal(12, 2)
  diferencia               Decimal?  @db.Decimal(12, 2)

  observacionesCierre      String?

  ventas                   Venta[]

  @@index([userId, cierreEn])
  @@map("turno")
}
